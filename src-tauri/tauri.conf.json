{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalSendStudio",
  "version": "0.2.0",
  "identifier": "com.localsendstudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LocalSendStudio",
        "width": 1180,
        "height": 780,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Share files across your local network",
    "longDescription": "LocalSendStudio finds other devices on your Wi-Fi or LAN and lets you send files, browse shared folders and sync folders. No cloud account and no internet needed.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "depends": [] }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
